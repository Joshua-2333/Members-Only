<h2>Login</h2>

<form method="POST" action="/auth/login">
  <div>
    <label>Email</label><br />
    <input type="email" name="username" required />
  </div>

  <div>
    <label>Password</label><br />
    <input type="password" name="password" required />
  </div>

  <button type="submit">Login</button>
</form>
