<!--login.ejs-->
<%
const pageContent = `
<h2>Login</h2>

<div id="errorMessage" class="error" role="alert" aria-live="polite">
  ${locals.error || ''}
</div>

<form id="loginForm" method="POST" action="/auth/login" novalidate>
  <label for="username">Email</label>
  <input id="username" name="username" type="email" required />

  <label for="password">Password</label>
  <div class="passwordWrapper">
    <input id="password" name="password" type="password" required aria-describedby="passwordToggle" />
    <span
      id="passwordToggle"
      class="material-symbols-outlined togglePassword"
      data-target="password"
      role="button"
      tabindex="0"
      aria-label="Show password"
      aria-pressed="false"
    >visibility</span>
  </div>

  <button type="submit">Login</button>
</form>

<script>
(() => {
  const errorMessage = document.getElementById('errorMessage');
  const username = document.getElementById('username');
  const passwordEl = document.getElementById('password');

  document.querySelectorAll('.togglePassword').forEach(icon => {
    const toggle = () => {
      const input = document.getElementById(icon.dataset.target);
      if (!input) return;

      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      icon.textContent = isHidden ? 'visibility_off' : 'visibility';
      icon.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      icon.setAttribute('aria-pressed', String(isHidden));
    };

    icon.addEventListener('click', toggle);
    icon.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });

  document.getElementById('loginForm').addEventListener('submit', e => {
    const email = username.value.trim();
    const password = passwordEl.value;
    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;

    if (!email || !password) {
      e.preventDefault();
      errorMessage.textContent = 'Both fields are required.';
      return;
    }

    if (!emailRegex.test(email)) {
      e.preventDefault();
      errorMessage.textContent = 'Invalid email address.';
      return;
    }

    errorMessage.textContent = '';
  });
})();
</script>
`;
%>

<%- include('layout', { currentUser, content: pageContent }) %>
