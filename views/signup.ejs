<!--signup.ejs-->
<%
const pageContent = `
<h2>Sign Up</h2>

<div id="errorMessage" class="error" role="alert" aria-live="polite">
  ${locals.error || ''}
</div>

<form id="signupForm" method="POST" action="/auth/signup" novalidate>
  <label for="firstName">First Name</label>
  <input id="firstName" name="firstName" required />

  <label for="lastName">Last Name</label>
  <input id="lastName" name="lastName" required />

  <label for="username">Email</label>
  <input id="username" name="username" type="email" required />

  <label for="password">Password</label>
  <div class="passwordWrapper">
    <input id="password" name="password" type="password" required aria-describedby="passwordToggle" />
    <span
      id="passwordToggle"
      class="material-symbols-outlined togglePassword"
      data-target="password"
      role="button"
      tabindex="0"
      aria-label="Show password"
      aria-pressed="false"
    >visibility</span>
  </div>

  <label for="confirmPassword">Confirm Password</label>
  <div class="passwordWrapper">
    <input id="confirmPassword" name="confirmPassword" type="password" required aria-describedby="confirmPasswordToggle" />
    <span
      id="confirmPasswordToggle"
      class="material-symbols-outlined togglePassword"
      data-target="confirmPassword"
      role="button"
      tabindex="0"
      aria-label="Show password"
      aria-pressed="false"
    >visibility</span>
  </div>

  <button type="submit">Create Account</button>
</form>

<script>
(() => {
  const errorMessage = document.getElementById('errorMessage');
  const firstNameEl = document.getElementById('firstName');
  const lastNameEl = document.getElementById('lastName');
  const username = document.getElementById('username');
  const passwordEl = document.getElementById('password');
  const confirmPasswordEl = document.getElementById('confirmPassword');

  document.querySelectorAll('.togglePassword').forEach(icon => {
    const toggle = () => {
      const input = document.getElementById(icon.dataset.target);
      if (!input) return;
      const hidden = input.type === 'password';
      input.type = hidden ? 'text' : 'password';
      icon.textContent = hidden ? 'visibility_off' : 'visibility';
      icon.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
      icon.setAttribute('aria-pressed', String(hidden));
    };

    icon.addEventListener('click', toggle);
    icon.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });

  document.getElementById('signupForm').addEventListener('submit', e => {
    if (
      !firstNameEl.value.trim() ||
      !lastNameEl.value.trim() ||
      !username.value.trim() ||
      !passwordEl.value ||
      !confirmPasswordEl.value
    ) {
      e.preventDefault();
      errorMessage.textContent = 'All fields are required.';
      return;
    }

    if (passwordEl.value !== confirmPasswordEl.value) {
      e.preventDefault();
      errorMessage.textContent = 'Passwords do not match.';
    } else {
      errorMessage.textContent = '';
    }
  });
})();
</script>
`;
%>

<%- include('layout', { currentUser, content: pageContent }) %>
