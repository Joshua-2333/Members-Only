<!--join.ejs-->
<%
const pageContent = `
<h2>Join The Inner Circle</h2>

${successMessage ? `
  <div class="membership-unlock">
    <span>${successMessage}</span>
  </div>
` : `
  <p>Answer the question below to prove you belong.</p>

  ${error ? `<div class="error" role="alert">${error}</div>` : ''}

  <form method="POST" action="/join" novalidate>
    <label for="answer">${question}</label>
    <input
      id="answer"
      name="answer"
      type="number"
      required
      autofocus
    />
    <button type="submit">Join</button>
  </form>
`}
`;
%>

<%- include('layout', { currentUser, content: pageContent }) %>
